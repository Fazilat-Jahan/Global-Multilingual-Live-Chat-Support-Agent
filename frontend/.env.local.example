# Full WebSocket endpoint URL the widget connects to (frontend/components/ChatWidget.tsx,
# frontend/lib/websocket.ts). Must be the COMPLETE url: scheme + host + the /ws/chat path —
# not just a bare domain. Local dev uses ws://; any real deployment (including the backend on
# Vercel below) must use wss:// since the page itself is served over https://.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/chat
# Example against the deployed backend:
# NEXT_PUBLIC_WS_URL=wss://global-multilingual-live-chat-suppo.vercel.app/ws/chat

# Phase 12 (spec 5.1): comma-separated origins of sites allowed to embed
# the widget iframe. Used only in next.config.mjs to build the CSP
# frame-ancestors header for /widget. Default matches the local dev
# frontend; production must list the client website domain(s).
WIDGET_ALLOWED_EMBEDDERS=http://localhost:3000
