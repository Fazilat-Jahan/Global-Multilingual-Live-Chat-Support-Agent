# --- LLM Provider (Gemini via OpenAI-compatible endpoint) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://support_user:support_pass@localhost:5432/support_agent

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Escalation notifications (wired in Phase 7) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SLACK_WEBHOOK_URL=
