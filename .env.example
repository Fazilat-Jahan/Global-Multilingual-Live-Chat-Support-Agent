# --- LLM Provider (Gemini via OpenAI-compatible endpoint) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- PostgreSQL ---
# Must keep the +asyncpg driver in the scheme (our engine is async-only).
# For managed Postgres (Neon/Supabase/RDS) that requires TLS, do NOT use a
# libpq-style "?sslmode=require" query param — asyncpg's Python API takes
# TLS as a connect_args={"ssl": ...} kwarg instead, which backend/db/
# connection.py already applies automatically for any non-localhost host.
DATABASE_URL=postgresql+asyncpg://support_user:support_pass@localhost:5432/support_agent

# --- Redis ---
REDIS_URL=

# --- Qdrant ---
QDRANT_URL=
QDRANT_API_KEY=

# --- Escalation notifications (wired in Phase 7) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Recipient for escalation emails (spec 17.1). Falls back to SMTP_USER if unset.
ESCALATION_EMAIL_TO=
SLACK_WEBHOOK_URL=

# --- Rate limiting (Phase 8, spec 13.1) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_SESSION_PER_MINUTE=20
RATE_LIMIT_PER_SESSION_PER_HOUR=200
RATE_LIMIT_PER_IP_PER_MINUTE=60
RATE_LIMIT_PER_AUTHENTICATED_CUSTOMER_PER_MINUTE=30
RATE_LIMIT_LLM_CALLS_PER_MINUTE_GLOBAL=100
RATE_LIMIT_WS_CONNECTIONS_PER_IP=5

# --- Data retention (Phase 8, spec 16.1) ---
RETENTION_MESSAGES_DAYS=90
RETENTION_TICKETS_DAYS=365
RETENTION_AUDIT_DAYS=365

# --- Light tenant isolation (Phase 8) ---
TENANT_ID=default

# --- Admin API (Phase 16, spec 18.2; also Phase 8's data-deletion endpoint) ---
# API key for POST /api/admin/knowledge-base/reingest and
# POST /api/admin/data-deletion. If empty, admin endpoints return 403.
# Generate a strong random value for production.
ADMIN_API_KEY=

# --- WebSocket session tokens (spec 12.1, Phase 6) ---
# HMAC-SHA256 secret signing the anonymous session token issued by
# POST /api/sessions/create. If empty (local-dev default), the WebSocket
# upgrade does not require a token, so existing dev workflows/tests keep
# working unauthenticated. Production must set a real value, min 32 chars
# (generate via `openssl rand -hex 32`, per spec 20.2).
SESSION_SECRET=

# --- CORS / origin policy (spec 12.3, Phase 12) ---
# Comma-separated origins (scheme + host + port) allowed to call the API
# directly and open WebSocket upgrades. The embedded widget itself talks to
# the backend from the widget host origin. Default matches local dev;
# production must list the client website domain(s) plus the widget host.
ALLOWED_ORIGINS=
